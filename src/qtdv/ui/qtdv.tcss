HeaderTitle { content-align: left middle; }  /* title and file location start at the left, after the icon */
#filters { height: 3; }
#search { width: 1fr; }
#type { width: 14; content-align: center middle; }
#date-from, #date-to { width: 22; }
Input.invalid { border: tall red; }

#main { height: 1fr; }
#top { height: 3fr; }
#files { width: 3fr; height: 100%; }
#side { width: 2fr; height: 100%; }
#profile-box { height: 2fr; }
#sheets { height: 1fr; }
#preview-box { height: 2fr; width: 100%; }
#files, #sheets, #preview-box, #profile-box { border: round $primary; }
#preview, #profile { width: auto; }
#files:focus, #sheets:focus, #preview-box:focus, #profile-box:focus { border: round $accent; }  /* the panel that has focus */

#status { height: 1; padding: 0 1; color: $text-muted; }

ConfirmLargeFile { align: center middle; }
#dialog { width: 50; height: auto; padding: 1 2; border: thick $warning; background: $surface; }

ColumnPicker { align: center middle; }
#picker { width: 60; height: 70%; padding: 1 2; border: thick $primary; background: $surface; }

/* Narrow window (few columns): the Profile hides. The right-hand column stays only while a workbook is open,
   so its Sheets / Tables list can still be used. i shows the Profile full screen. */
#main.narrow #profile-box { display: none; }
#main.narrow #side { display: none; }
#main.narrow.with-sheets #side { display: block; }
#main.narrow.show-profile #files { display: none; }
#main.narrow.show-profile #side { display: block; width: 100%; }
#main.narrow.show-profile #profile-box { display: block; }

/* Short window (few rows): Files, Profile and Sheets fill the screen; p swaps them for the Preview. */
#main.short #preview-box { display: none; }
#main.short.show-preview #preview-box { display: block; height: 1fr; }
#main.short.show-preview #top { display: none; }
#main.short #top { height: 1fr; }
