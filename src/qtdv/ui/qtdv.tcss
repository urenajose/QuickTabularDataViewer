#filters { height: 3; }
#search { width: 1fr; }
#type { width: 14; content-align: center middle; }
#date-from, #date-to { width: 22; }
Input.invalid { border: tall red; }

#main { height: 1fr; }
#left { width: 11fr; }
#files, #sheets { border: round $primary; }
#files { height: 3fr; }
#lower { height: 2fr; }
#sheets { width: 30; height: 100%; }
#profile-box { width: 1fr; height: 100%; }
#preview-box { width: 9fr; height: 100%; }
#preview-box, #profile-box { border: round $primary; }

#status { height: 1; padding: 0 1; color: $text-muted; }

ConfirmLargeFile { align: center middle; }
#dialog { width: 50; height: auto; padding: 1 2; border: thick $warning; background: $surface; }

ColumnPicker { align: center middle; }
#picker { width: 60; height: 70%; padding: 1 2; border: thick $primary; background: $surface; }

/* Narrow terminal: Files, Sheets and Profile fill the screen; p swaps them for the Preview. */
#main.narrow #left { width: 1fr; }
#main.narrow #preview-box { display: none; }
#main.narrow.show-preview #preview-box { display: block; width: 1fr; }
#main.narrow.show-preview #left { display: none; }
